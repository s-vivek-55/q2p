  "order_request_api": {
    "method": "POST",
    "path": "/Customer/v3/Ordering/orderRequest",
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "LumenOrderRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteId",
        "orderType",
        "productFamily",
        "customer",
        "serviceLocation",
        "port",
        "cloudConnection",
        "addOns",
        "billing"
      ],
      "properties": {
        "quoteId": {"type": "string", "pattern": "^Q-[0-9A-F]{8}$"},
        "orderType": {"type": "string", "const": "NEW_INSTALL"},
        "productFamily": {"type": "string", "const": "NAAS_CLOUD_CONNECT"},
        "customer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 120}
          }
        },
        "serviceLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["siteCode", "city", "countryCode"],
          "properties": {
            "siteCode": {"type": "string", "pattern": "^[A-Z]{3}[0-9]$"},
            "city": {"type": "string", "minLength": 1},
            "countryCode": {"type": "string", "pattern": "^[A-Z]{2}$"}
          }
        },
        "port": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speed", "quantity", "bandwidthMbps"],
          "properties": {
            "speed": {"type": "string", "enum": ["1G", "10G"]},
            "quantity": {"type": "integer", "minimum": 1, "maximum": 16},
            "bandwidthMbps": {"type": "integer", "minimum": 1}
          }
        },
        "cloudConnection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "region", "product"],
          "properties": {
            "provider": {"type": "string", "enum": ["AWS", "GCP", "AZURE"]},
            "region": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1}
          }
        },
        "addOns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ddosProtection"],
          "properties": {
            "ddosProtection": {"type": "boolean"}
          }
        },
        "billing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pricingModel",
            "currency",
            "hourlyRateUsd",
            "estimatedMonthlyUsd"
          ],
          "properties": {
            "pricingModel": {"type": "string", "const": "HOURLY"},
            "currency": {"type": "string", "const": "USD"},
            "hourlyRateUsd": {"type": "number", "minimum": 0},
            "estimatedMonthlyUsd": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
