# Copy to .env and fill in. Never commit the real .env file.

# Hackathon team LLM access (LiteLLM gateway) - see the
# "2026 Hackathon Team LLM Access Guide" for both values.
LITELLM_API_KEY=sk-PYVKEquo_OXpbI3DpIS2CA
LITELLM_BASE_URL=https://litellm-api.azu-aks-hcahktn-np-cus-01.azu.corp.intranet/v1
# (Plain OpenAI instead of the gateway: set OPENAI_API_KEY and leave
#  LITELLM_BASE_URL empty.)

# Model profile:
#   dev  (default) = gpt-5-nano for NLU + payload (cheapest, for development)
#   prod           = gpt-5-mini (NLU) + gpt-5.3-codex (payload)
MODEL_PROFILE=dev

# Optional overrides (use model names your gateway key is allowed to call;
# the sidebar "Test OpenAI connection" button lists them)
# NLU_MODEL=gpt-5-nano
# CODEX_MODEL=gpt-5-nano
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# SESSION_BUDGET_USD=2.00
